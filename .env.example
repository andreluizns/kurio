# Camada de mocks (MSW). "false" desativa a API/Socket.IO simulados. Padrão: ativada.
VITE_ENABLE_MOCKS=true
# Painel de controle dos mocks (cenários e eventos). "false" oculta o painel.
VITE_MOCK_PANEL=true
# Origem do servidor Socket.IO (opcional). Padrão: a própria origem da aplicação.
# VITE_SOCKET_URL=
